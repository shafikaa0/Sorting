#include <stdio.h>

int main()
{
    int size, element;

    printf("Enter the size: ");
    scanf("%d", &size);

    int arr[size];

    printf("Enter the number of elements: ");
    scanf("%d", &element);

    if(element > size || element <= 0)
    {
        printf("Invalid number of elements");
        return 0;
    }

    printf("Enter the elements: ");
    for(int i = 0; i < element; i++)
    {
        scanf("%d", &arr[i]);
    }

    // Insertion Sort
    for(int i = 1; i < element; i++)
    {
        int temp = arr[i];
        int j = i - 1;

        while(j >= 0 && arr[j] > temp)
        {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = temp;
    }

    // Print Sorted Array
    printf("Sorted array: ");

    for(int i = 0; i < element; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
